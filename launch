#!/bin/sh
# Portable, self-contained launcher. rofi doesn't expand ~/$HOME in mode paths,
# so resolve them from this file's dir. -no-config + -theme keep it fully isolated:
# it never reads or depends on the user's ~/.config/rofi/config.rasi.
dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
s="$dir/scripts"
exec rofi -no-config -show combi \
    -theme       "$dir/spotlight.rasi" \
    -modes       "combi,files:$s/files.sh" \
    -combi-modes "web:$s/web.sh,window,drun,quick:$s/files-quick.sh" \
    "$@"
