#!/bin/sh
# Portable launcher. rofi doesn't expand ~/$HOME in mode paths, so resolve the
# scripts dir from this file's own location and pass the modes on the CLI.
# Bind your WM/DE hotkey to this file.
dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
s="$dir/scripts"
exec rofi -show combi \
    -modes       "combi,files:$s/files.sh" \
    -combi-modes "web:$s/web.sh,window,drun,quick:$s/files-quick.sh" \
    "$@"
