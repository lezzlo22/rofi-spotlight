configuration {
    combi-hide-mode-prefix: true;
    show-icons: true;
    icon-theme: "Papirus-Dark";
    drun-display-format: "{name}";
    window-format: "{c}   {t}";
    font: "sans-serif 14";
}

/* Colors follow pywal: @bg / @fg / @accent / @sel-fg come from colors-wal.rasi,
   a symlink to ~/.cache/wal/colors-rofi-spotlight.rasi (generated by the bundled
   pywal template). No pywal? Drop a static colors-wal.rasi defining the same vars. */
@import "colors-wal.rasi"

/* Spotlight-style: centered box, big input, few rows */
* {
    bg-alt: #ffffff18;   /* subtle inset for the input bar, theme-agnostic overlay */
    fg-dim: #ffffff99;   /* placeholder / dim text */
    background-color: transparent;
    text-color: @fg;
    foreground: @fg; background: transparent; separatorcolor: transparent; border-color: transparent;
    normal-foreground: @fg; alternate-normal-foreground: @fg; active-foreground: @fg; alternate-active-foreground: @fg; urgent-foreground: @fg; alternate-urgent-foreground: @fg;
    normal-background: transparent; alternate-normal-background: transparent; active-background: transparent; alternate-active-background: transparent; urgent-background: transparent; alternate-urgent-background: transparent;
    selected-normal-foreground: @sel-fg; selected-active-foreground: @sel-fg; selected-urgent-foreground: @sel-fg;
    selected-normal-background: @accent; selected-active-background: @accent; selected-urgent-background: @accent;
}
window {
    location: center;
    anchor: center;
    width: 680px;
    background-color: @bg;
    border: 1px;
    border-color: @bg-alt;
    border-radius: 14px;
    padding: 0;
}
mainbox { border: 0; padding: 10px; spacing: 8px; children: [ inputbar, message, listview ]; }
inputbar { padding: 10px 12px; spacing: 10px; border: 0; border-radius: 10px; background-color: @bg-alt; children: [ icon-search, entry ]; }
icon-search { expand: false; filename: "search"; size: 22px; vertical-align: 0.5; }
entry { placeholder-color: @fg-dim; text-color: @fg; }
entry { font: "sans-serif 18"; }
entry { placeholder: "Search apps, windows and files  ·  Ctrl+Tab: deep file search"; }
listview { lines: 8; scrollbar: false; fixed-height: true; border: 0; spacing: 2px; padding: 0; }
element { text-color: @fg; padding: 8px 10px; spacing: 12px; border: 0; border-radius: 8px; }
element selected { background-color: @accent; }
element-icon { size: 28px; background-color: transparent; }
element-text { text-color: inherit; vertical-align: 0.5; highlight: bold; }
textbox { text-color: @fg-dim; padding: 4px 10px; }
